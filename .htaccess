Options -Indexes
Options +FollowSymLinks

RewriteEngine On

# Redirect HTTP to HTTPS (Railway provides HTTPS automatically)
# Skip redirect for Railway health checks
RewriteCond %{REQUEST_URI} !^/health\.php$
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Server-side code and project files are never served to browsers.
# (The Docker image copies the whole project into the web folder.)
RewriteRule ^(config|debug|migrations|scripts|tests|helpers|repositories|services|vendor|reports|\.git|\.github)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|Dockerfile|docker-entrypoint\.sh|phpunit\.xml|railway\.toml|env\.example|BACKUPS\.md|README\.md|SECURITY\.md|\.gitignore|\.gitattributes|\.dockerignore)$ - [F,L]

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index
RewriteRule ^ index.html [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # GPS capture on the audit form needs geolocation for our own origin only.
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
    Header set X-Permitted-Cross-Domain-Policies "none"
    # Safe to set unconditionally: browsers ignore HSTS on plain HTTP
    # responses, so this only takes effect once already on HTTPS.
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Disable directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# The public landing page is a plain file that Apache serves, so PHP cannot add
# its policy header. Set it here. Scripts may only come from this site
# ('inline-speculation-rules' allows the small prerender hint in index.html).
<IfModule mod_headers.c>
    # style-src is only the fallback for very old browsers; style-src-elem blocks injected <style> blocks (index.html has none)
    <Files "index.html">
        Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </Files>
</IfModule>

# Cache static assets
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|woff2)">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>


# Belt and braces: never serve these file types, wherever they are.
<FilesMatch "\.(sql|sh|lock|toml|log|bak|env)$">
    Require all denied
</FilesMatch>
